{
  "name": "vortex-game-kit",
  "version": "0.2.0",
  "description": "Shared standard, protocol and conformance tests for connecting games to Vortex Studio stories and editors.",
  "type": "module",
  "license": "MIT",
  "repository": "github:ahku/vortex-game-kit",
  "engines": { "node": ">=20" },
  "files": ["dist", "docs", "AGENTS.md"],
  "exports": {
    "./protocol": { "types": "./dist/protocol/index.d.ts", "default": "./dist/protocol/index.js" },
    "./conformance": { "types": "./dist/conformance/index.d.ts", "default": "./dist/conformance/index.js" },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
