{
  "name": "vortex-game-kit",
  "version": "0.19.0-next.6",
  "description": "Everything a game needs to run Vortex Studio stories: the story player, the engine and schema it runs on, the protocol, the integration standard and conformance tests.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahku/vortex-game-kit.git"
  },
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "story",
    "engine",
    "schema",
    "shared",
    "bin",
    "docs",
    "AGENTS.md",
    "CHANGELOG.md"
  ],
  "exports": {
    "./protocol": {
      "types": "./dist/protocol/index.d.ts",
      "default": "./dist/protocol/index.js"
    },
    "./conformance": {
      "types": "./dist/conformance/index.d.ts",
      "default": "./dist/conformance/index.js"
    },
    "./story": {
      "types": "./story/vns-player.d.ts",
      "default": "./story/vns-player.js"
    },
    "./engine": {
      "types": "./engine/index.d.ts",
      "default": "./engine/index.js"
    },
    "./schema": {
      "types": "./schema/index.d.ts",
      "default": "./schema/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build",
    "release": "(git diff --quiet && git diff --cached --quiet || (echo 'Commit your changes first.' && false)) && npm run check && git push && git tag v$npm_package_version && git push origin v$npm_package_version",
    "prepack": "npm run build",
    "pack:check": "npm pack --dry-run"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "@types/node": "^22.10.0"
  },
  "homepage": "https://github.com/ahku/vortex-game-kit#readme",
  "bugs": {
    "url": "https://github.com/ahku/vortex-game-kit/issues"
  },
  "keywords": [
    "visual-novel",
    "story",
    "game",
    "vortex",
    "web-component"
  ],
  "sideEffects": [
    "./story/vns-player.js"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "bin": {
    "vortex-story-import": "./bin/story-import.mjs"
  }
}
